# ==============================================================================
# NSE Paper-Trading & Intraday Research System - Environment Configuration
# NOTE: This system is STRICTLY for Paper-Trading simulation. Real trading is disabled.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PROJECT_NAME="NSE Paper-Trading System"

# Backend API Configuration
API_V1_STR=/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]

# Primary Database Configuration (Default: SQLite local database)
DATABASE_ASYNC_URL=sqlite+aiosqlite:///./data/nse_paper_trading.db
DATABASE_SYNC_URL=sqlite:///./data/nse_paper_trading.db

# Optional Future PostgreSQL Configuration (Reserved for future migration)
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=nse_paper_trading
# DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nse_paper_trading
# DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/nse_paper_trading

# Trading Engine Configuration (STRICTLY PAPER TRADING)
TRADING_MODE=PAPER
PAPER_INITIAL_CAPITAL=100000.0
MAX_CAPITAL_PER_DAY=50000.0
MAX_LOSS_PER_DAY=2000.0
MAX_OPEN_POSITIONS=3
ENGINE_SCAN_INTERVAL_SECONDS=1.0

# Market Data Provider (Phase 1 Mock / Later Angel One)
MARKET_DATA_PROVIDER=mock
# ANGEL_ONE_API_KEY=
# ANGEL_ONE_CLIENT_CODE=
# ANGEL_ONE_PASSWORD=
# ANGEL_ONE_TOTP_KEY=
