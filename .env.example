# ==============================================================================
# NSE Paper-Trading & Intraday Research System - Environment Configuration
# NOTE: This system is STRICTLY for Paper-Trading simulation. Real trading is disabled.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PROJECT_NAME="NSE Paper-Trading System"

# Backend API Configuration
API_V1_STR=/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Primary Database Configuration (Default: SQLite local database)
DATABASE_ASYNC_URL=sqlite+aiosqlite:///./data/nse_paper_trading.db
DATABASE_SYNC_URL=sqlite:///./data/nse_paper_trading.db

# Trading Engine Configuration (STRICTLY PAPER TRADING)
TRADING_MODE=PAPER
PAPER_INITIAL_CAPITAL=100000.0
MAX_CAPITAL_PER_DAY=50000.0
MAX_LOSS_PER_DAY=2000.0
MAX_OPEN_POSITIONS=3
ENGINE_SCAN_INTERVAL_SECONDS=1.0

# Market Data Provider (Phase 1 mock only)
MARKET_DATA_PROVIDER=mock
